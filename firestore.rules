rules_version = '2';

// DharmaChat Firestore security rules.
//
// Premium status is server-only. The `/api/verify-payment` endpoint
// uses the Firebase Admin SDK (which bypasses these rules) to write
// `users/{uid}/premium/status` after Razorpay payment is verified.
// Clients can READ their own premium doc: that's how cross-device
// sync works in nav.js, but they CANNOT write it. This is what
// stops "give myself premium with one console command" attacks.
service cloud.firestore {
  match /databases/{database}/documents {

    // Premium status: read-own, server-only writes.
    match /users/{uid}/premium/{doc} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // User stats (totalQuestions, questionsToday, firstSeen etc.)
    // Written server-side by api/chat.js via Admin SDK. Users can read their own.
    match /users/{uid}/stats/{doc} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Anything else under /users/{uid} that the app legitimately needs
    // the client to write (preferences, etc.). Add explicit rules here
    // when you introduce them: do NOT broaden to a wildcard.
    //
    // Example template (uncomment + adapt as needed):
    // match /users/{uid}/preferences/{doc} {
    //   allow read, write: if request.auth != null && request.auth.uid == uid;
    // }

    // App-launch waitlist: anyone can add their email, nobody can read/edit/delete.
    // Duplicate-check is handled client-side; even if bypassed, duplicates are harmless.
    match /notify_me/{docId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 254;
      allow read, update, delete: if false;
    }

    // community.html's prayer wall reads and writes `community_comments`.
    // There is deliberately NO rule for it yet, so it falls through to the
    // default-deny below and the wall stays closed. community.html is
    // noindex'd and out of sitemap.xml to match. Before opening this up,
    // note that the renderer in community.html interpolates `d.name` and
    // `d.text` straight into innerHTML, so a public write path is an XSS
    // sink until that is escaped, and there is no moderation tooling on the
    // web side. Template for when both are handled:
    //
    // match /community_comments/{docId} {
    //   allow read: if true;
    //   allow create: if request.auth != null
    //                 && request.resource.data.uid == request.auth.uid
    //                 && request.resource.data.text is string
    //                 && request.resource.data.text.size() > 2
    //                 && request.resource.data.text.size() <= 2000;
    //   allow update, delete: if false;
    // }

    // Default-deny everything else. Better to break a feature loudly
    // than leak data silently.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
